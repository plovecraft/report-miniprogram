# Storage / runtime
STORAGE_DIR=./storage
OUTPUT_DIR=./storage/outputs
CORS_ORIGINS=*
PUBLIC_BASE_URL=https://your-backend-domain.com
MAX_UPLOAD_MB=100

# Any OpenAI-compatible chat completions API can be used.
# Leave these empty to keep AI Planner in shadow-disabled state.
#
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
#
# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# SiliconFlow example:
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

LLM_BASE_URL=
LLM_API_KEY=replace-with-your-key
LLM_MODEL=
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.2
LLM_RESPONSE_LOG_CHARS=8000
DOC_EXTRACTION_TIMEOUT=20


# Optional multimodal image recognition.
# When enabled and LLM_API_KEY/LLM_MODEL are configured, the backend will call
# the same OpenAI-compatible chat completions endpoint with image input first,
# then fall back to local OpenCV rules if the model call fails.
VISION_RECOGNITION_ENABLED=0
VISION_RECOGNITION_TIMEOUT=60
VISION_RECOGNITION_TEMPERATURE=0
VISION_RECOGNITION_REVIEW_THRESHOLD=0.55

# Example for a multimodal-compatible endpoint:
# LLM_BASE_URL=https://node-hk.sssaicodeapi.com/api
# LLM_MODEL=gpt-5.4-mini
# Optional on Windows, for example:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Disable unstable table recommendation/editing/writing flow.
TABLE_FEATURE_ENABLED=0
