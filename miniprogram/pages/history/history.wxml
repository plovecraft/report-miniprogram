<view class="container history-page">
  <view class="page-head">
    <view>
      <view class="page-title">任务历史</view>
      <view class="muted page-desc">多个报告任务可以同时生成，进入任务可继续确认、查看进度或下载结果。</view>
    </view>
    <button class="head-button" size="mini" bindtap="createTask">新建</button>
  </view>

  <view wx:if="{{errorMessage}}" class="error-box">{{errorMessage}}</view>

  <view wx:if="{{loading}}" class="section loading-box">正在读取任务...</view>

  <view wx:elif="{{!tasks.length}}" class="section empty-box">
    <view class="empty-title">暂无任务</view>
    <view class="muted">创建报告任务后，会在这里看到各个任务的状态。</view>
  </view>

  <view wx:else class="task-list">
    <view wx:for="{{tasks}}" wx:key="taskId" class="task-card" data-task-id="{{item.taskId}}" bindtap="openTask">
      <view class="task-card-head">
        <view class="task-title">{{item.experimentNo || '未填写实验序号'}}</view>
        <view class="task-status status-{{item.status}}">{{item.statusText}}</view>
      </view>
      <view class="task-message">{{item.message}}</view>
      <progress percent="{{item.progress}}" active="{{item.status !== 'done' && item.status !== 'failed'}}" stroke-width="5" />
      <view class="task-meta">
        <text>{{item.progress}}%</text>
        <text>{{item.updatedText}}</text>
      </view>
    </view>
  </view>
</view>
